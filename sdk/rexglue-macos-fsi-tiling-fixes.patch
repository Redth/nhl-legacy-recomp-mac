+      spv::OpSelect, type_float_,
+      builder_->createBinOp(spv::OpFOrdEqual, type_bool_, result,
+                            builder_->makeFloatConstant(-INFINITY)),
+      builder_->makeFloatConstant(-FLT_MAX), result);
