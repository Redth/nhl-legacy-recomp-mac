+void VulkanCommandProcessor::ReportReadbackStats() {
+  static const bool stats = std::getenv("REX_READBACK_STATS") != nullptr;
+  if (stats && readback_drains_this_frame_) {
+    REXGPU_INFO(
+        "[rex-readback] drains={} bytes={} avg_draws_between_drains={:.1f} "
+        "draws_after_last={}",
+        readback_drains_this_frame_, readback_bytes_this_frame_,
+        double(readback_drain_gap_draws_) / double(readback_drains_this_frame_),
+        draws_since_last_drain_);
+  }
+  readback_drains_this_frame_ = 0;
+  readback_drain_gap_draws_ = 0;
+  draws_since_last_drain_ = 0;
+  readback_bytes_this_frame_ = 0;
+}
