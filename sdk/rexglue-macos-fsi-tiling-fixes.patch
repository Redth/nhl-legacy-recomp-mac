-  bool IsClearingDepth() const { return rb_copy_control.depth_clear_enable != 0; }
+  // REX_CLEAR_DEPTH_WITH_COLOR: NHL's predicated-tiling scene renders two
+  // 640-pitch halves that share BOTH the colour EDRAM (base 0) and the depth
