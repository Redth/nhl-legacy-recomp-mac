+    deferred_readback_mapping_ = nullptr;
+  }
+  if (deferred_readback_buffer_ != VK_NULL_HANDLE) {
+    dfn.vkDestroyBuffer(device, deferred_readback_buffer_, nullptr);
+    deferred_readback_buffer_ = VK_NULL_HANDLE;
+  }
+  if (deferred_readback_memory_ != VK_NULL_HANDLE) {
+    dfn.vkFreeMemory(device, deferred_readback_memory_, nullptr);
+    deferred_readback_memory_ = VK_NULL_HANDLE;
+  }
+  deferred_readback_capacity_ = 0;
+  deferred_readback_used_ = 0;
