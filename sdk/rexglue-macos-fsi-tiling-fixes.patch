+# Prebuilt (IMPORTED) FidelityFX libraries can't be install(TARGETS)/exported —
+# they're DELAYLOAD'd into the rexruntime shared lib, so only the DLL needs to
+# ship. Install those as files; build-in-tree targets go through install(TARGETS).
 set(REXGLUE_INSTALL_FIDELITYFX_TARGETS)
-if(TARGET amd_fidelityfx_vk)
-    list(APPEND REXGLUE_INSTALL_FIDELITYFX_TARGETS amd_fidelityfx_vk)
-endif()
-
-if(TARGET amd_fidelityfx_dx12)
-    list(APPEND REXGLUE_INSTALL_FIDELITYFX_TARGETS amd_fidelityfx_dx12)
