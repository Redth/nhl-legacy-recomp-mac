+
+bool VulkanCommandProcessor::EnsureDeferredReadbackCapacity(uint32_t needed) {
+  if (needed <= deferred_readback_capacity_) {
+    return true;
+  }
+  // Growing frees the old buffer, which earlier recorded copies may still
+  // reference, so everything pending has to land first.
+  FlushDeferredReadbacks();
+  DestroyDeferredReadbackBuffer();
+  // Menus queue ~21 readbacks of ~2 MB each, so a small arena would overflow
+  // and force several mid-frame flushes - defeating the point. Start big.
+  uint32_t new_capacity = 64 * 1024 * 1024;
+  while (new_capacity < needed) {
+    new_capacity *= 2;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  VkBuffer buffer = VK_NULL_HANDLE;
+  VkDeviceMemory memory = VK_NULL_HANDLE;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          vulkan_device, new_capacity, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          ui::vulkan::util::MemoryPurpose::kReadback, buffer, memory)) {
+    REXGPU_ERROR("Failed to create a {} MB deferred resolve readback buffer", new_capacity >> 20);
+    return false;
+  }
+  void* mapping = nullptr;
+  if (dfn.vkMapMemory(device, memory, 0, VK_WHOLE_SIZE, 0, &mapping) != VK_SUCCESS) {
+    dfn.vkDestroyBuffer(device, buffer, nullptr);
+    dfn.vkFreeMemory(device, memory, nullptr);
+    return false;
+  }
+  deferred_readback_buffer_ = buffer;
+  deferred_readback_memory_ = memory;
+  deferred_readback_mapping_ = mapping;
+  deferred_readback_capacity_ = new_capacity;
+  deferred_readback_used_ = 0;
+  return true;
+}
+
+// Completes every deferred readback with ONE GPU drain.
+//
+// ReadbackResolveMode::kFull otherwise calls AwaitAllQueueOperationsCompletion()
+// per readback resolve, and that both ends the current submission and blocks on
+// its fence. Menus issue 20-25 such resolves per frame (versus 1-4 in gameplay),
+// so the frame paid 20-25 full pipeline flushes - which is why heavy scenes ran
+// at ~14 fps while gameplay held 30.
+void VulkanCommandProcessor::FlushDeferredReadbacks() {
+  if (deferred_readbacks_.empty() || in_deferred_readback_flush_) {
+    deferred_readback_used_ = 0;
+    return;
+  }
+  in_deferred_readback_flush_ = true;
+  ++readback_drains_this_frame_;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (AwaitAllQueueOperationsCompletion() && deferred_readback_mapping_) {
+    VkMappedMemoryRange range = {};
+    range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+    range.memory = deferred_readback_memory_;
+    range.offset = 0;
+    range.size = VK_WHOLE_SIZE;
+    dfn.vkInvalidateMappedMemoryRanges(device, 1, &range);
+    for (const DeferredReadback& pending : deferred_readbacks_) {
+      uint8_t* destination = memory_->TranslatePhysical(pending.guest_address);
+      if (destination) {
+        std::memcpy(destination,
+                    reinterpret_cast<const uint8_t*>(deferred_readback_mapping_) + pending.offset,
+                    pending.length);
+      }
+    }
+  }
+  deferred_readbacks_.clear();
+  deferred_readback_used_ = 0;
+  in_deferred_readback_flush_ = false;
+}
